# Copy to backend/.env and fill in. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://agencypilot:agencypilot@localhost:5432/agencypilot

# LLM providers (leave empty to disable a provider)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5
# Per-request timeout and retries (exponential backoff) for every provider
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Insights: max CSV upload size, and how long AI summaries are cached
MAX_UPLOAD_MB=5
INSIGHTS_CACHE_TTL_SECONDS=600

# SEO audit: how long a (URL, provider) audit result is cached
SEO_CACHE_TTL_SECONDS=3600

# Copilot (RAG): local embedding model, upload limit, chunks retrieved per question, and the
# guardrail - if the best chunk's cosine similarity is below this, the LLM is skipped and the
# user is told the answer isn't in the documents. COPILOT_WARMUP loads the model and seeds the
# demo brief in a background thread at startup (false = load on first use).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COPILOT_MAX_UPLOAD_MB=10
COPILOT_TOP_K=5
COPILOT_MIN_SIMILARITY=0.5
COPILOT_WARMUP=true

# At startup, give each demo client with no SEO audits a realistic audit of its fictional
# site (built from sample_data/seo fixture HTML; no network or LLM call).
SEED_DEMO_DATA=true

# Per-IP limit on endpoints that call an LLM (summary, ask, SEO audit, Copilot chat, reports);
# requests beyond it get HTTP 429 with a Retry-After header.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Hugging Face model cache, kept outside the repo (and outside OneDrive)
HF_HOME=C:/Users/YOUR_USER/.cache/agencypilot-hf
